<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="com.LEAP.LEAPTrademarks"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="com.LEAP.LEAPTrademarks"
                   Version="11.0">
  <ExtensionList>
    <Extension Id="com.LEAP.LEAPTrademarks" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.LEAP.LEAPTrademarks">
      <DispatchInfo>
        <Resources>
          <MainPath>./web/public/redirect.html</MainPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--disable-application-cache</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>LEAP Trademarks (New)</Menu>
          <Geometry>
            <Size>
              <Width>250</Width>
              <Height>500</Height>
            </Size>
            <!-- Resizable like LEAP Utilities: the previous fixed size is now the MINIMUM; the user
                 can grow the panel freely. The layout is a single flexible column, so extra width/
                 height just gives the grids and lists more room. -->
            <MinSize>
              <Width>250</Width>
              <Height>500</Height>
            </MinSize>
            <MaxSize>
              <Width>2400</Width>
              <Height>2000</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon_light.png</Icon>
            <Icon Type="RollOver">./icons/icon_light.png</Icon>
            <Icon Type="DarkNormal">./icons/icon_dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon_dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
